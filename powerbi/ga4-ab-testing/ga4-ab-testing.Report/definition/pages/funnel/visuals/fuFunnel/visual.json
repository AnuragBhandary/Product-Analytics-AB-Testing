{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "fuFunnel",
  "position": {
    "x": 20,
    "y": 20,
    "z": 0,
    "height": 400,
    "width": 620,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "funnel",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FunnelStep"
                    }
                  },
                  "Property": "Step"
                }
              },
              "queryRef": "FunnelStep.Step",
              "nativeQueryRef": "Step",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Funnel Step Sessions"
                }
              },
              "queryRef": "_Measures.Funnel Step Sessions",
              "nativeQueryRef": "Funnel_Step_Sessions"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Column": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "FunnelStep"
                  }
                },
                "Property": "Step"
              }
            },
            "direction": "Ascending"
          }
        ]
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Closed funnel: sessions completing each step in order'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}