{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "fuDrop",
  "position": {
    "x": 650,
    "y": 20,
    "z": 1000,
    "height": 400,
    "width": 610,
    "tabOrder": 1000
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FunnelStep"
                    }
                  },
                  "Property": "Step"
                }
              },
              "queryRef": "FunnelStep.Step",
              "nativeQueryRef": "Step",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Funnel Step Drop-off %"
                }
              },
              "queryRef": "_Measures.Funnel Step Drop-off %",
              "nativeQueryRef": "Funnel_Step_Drop-off_%"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Column": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "FunnelStep"
                  }
                },
                "Property": "Step"
              }
            },
            "direction": "Ascending"
          }
        ]
      }
    },
    "objects": {
      "labels": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Drop-off at each step vs the previous one'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}