/// Measure table: every DAX measure lives here (see powerbi/measures.dax).
table _Measures
	lineageTag: 110bbea0-dc37-4dd4-8ebc-ea35c1ab13d8

	measure Sessions = SUM ( mart_daily_kpis[sessions] )
		formatString: #,0
		displayFolder: Overview
		lineageTag: 4b818a19-dd02-4cbf-902e-7ccf189b4b34

	measure Purchases = SUM ( mart_daily_kpis[purchases] )
		formatString: #,0
		displayFolder: Overview
		lineageTag: ea4fcf20-b458-4461-b3c8-29224529cd31

	measure Revenue = SUM ( mart_daily_kpis[revenue_usd] )
		formatString: \$#,0
		displayFolder: Overview
		lineageTag: 77029f46-f206-4ce2-a92b-dbfcd2b31766

	measure 'Session Conversion Rate' = DIVIDE ( SUM ( mart_daily_kpis[converting_sessions] ), [Sessions] )
		formatString: 0.00%
		displayFolder: Overview
		lineageTag: a711d6de-7c4a-467c-8451-07bd02e2f22a

	measure 'Average Order Value' = DIVIDE ( [Revenue], [Purchases] )
		formatString: \$#,0.00
		displayFolder: Overview
		lineageTag: db67f3bf-014c-4cc7-a450-8082446db567

	measure 'Revenue per Session' = DIVIDE ( [Revenue], [Sessions] )
		formatString: \$#,0.00
		displayFolder: Overview
		lineageTag: fb09bdec-84a4-4d01-b02e-c5d65e763f7a

	/// Engagement rate weighted by sessions (not an average of daily rates).
	measure 'Engagement Rate' =
			DIVIDE (
			    SUMX ( mart_daily_kpis, mart_daily_kpis[engagement_rate] * mart_daily_kpis[sessions] ),
			    [Sessions]
			)
		formatString: 0.0%
		displayFolder: Overview
		lineageTag: 20a60e48-8067-4ce2-a4a6-c2511848dac6

	/// Same period one week earlier (needs the Date table, see README).
	measure 'Revenue Previous Week' = CALCULATE ( [Revenue], DATEADD ( 'Date'[Date], -7, DAY ) )
		formatString: \$#,0
		displayFolder: Overview
		lineageTag: 316f1c95-9161-4e23-87da-dd081fe8a30a

	measure 'Revenue WoW %' = DIVIDE ( [Revenue] - [Revenue Previous Week], [Revenue Previous Week] )
		formatString: 0.0%
		displayFolder: Overview
		lineageTag: 813b476d-5cfd-4300-a04c-eade97fcb227

	/// 7-day rolling revenue for the trend line.
	measure 'Revenue 7d Rolling' =
			CALCULATE (
			    [Revenue],
			    DATESINPERIOD ( 'Date'[Date], MAX ( 'Date'[Date] ), -7, DAY )
			)
		formatString: \$#,0
		displayFolder: Overview
		lineageTag: 44caf352-5074-46d2-9f0c-a6ebb2fa1a4a

	measure 'Funnel Sessions' = SUM ( mart_funnel_weekly[sessions] )
		formatString: #,0
		displayFolder: Funnel
		lineageTag: c4e88432-66dd-4442-9879-92fc91467707

	/// open-funnel step rates
	measure 'View to Cart %' = DIVIDE ( SUM ( mart_funnel_weekly[open_add_to_cart] ), SUM ( mart_funnel_weekly[open_view_item] ) )
		formatString: 0.0%
		displayFolder: Funnel
		lineageTag: 4bd1545e-8c4f-4dc2-9205-66b6ec63e39a

	measure 'Cart to Checkout %' =
			DIVIDE (
			    SUM ( mart_funnel_weekly[open_begin_checkout] ),
			    SUM ( mart_funnel_weekly[open_add_to_cart] )
			)
		formatString: 0.0%
		displayFolder: Funnel
		lineageTag: 32880969-47fb-4877-a25d-f3981556bab1

	measure 'Checkout to Purchase %' = DIVIDE ( SUM ( mart_funnel_weekly[open_purchase] ), SUM ( mart_funnel_weekly[open_begin_checkout] ) )
		formatString: 0.0%
		displayFolder: Funnel
		lineageTag: b01f422f-0b05-47f3-b857-1da624d86bd9

	/// share of all sessions that complete every closed-funnel step
	measure 'Closed Funnel Completion %' = DIVIDE ( SUM ( mart_funnel_weekly[closed_purchase] ), [Funnel Sessions] )
		formatString: 0.00%
		displayFolder: Funnel
		lineageTag: b1f352e9-a21e-4187-a646-73c9de4c0d00

	/// Value for the funnel visual: one measure, switched by the FunnelStep table (see README step 4).
	measure 'Funnel Step Sessions' =
			SWITCH (
			    SELECTEDVALUE ( FunnelStep[Order] ),
			    1, SUM ( mart_funnel_weekly[closed_view_item] ),
			    2, SUM ( mart_funnel_weekly[closed_add_to_cart] ),
			    3, SUM ( mart_funnel_weekly[closed_begin_checkout] ),
			    4, SUM ( mart_funnel_weekly[closed_add_shipping_info] ),
			    5, SUM ( mart_funnel_weekly[closed_add_payment_info] ),
			    6, SUM ( mart_funnel_weekly[closed_purchase] )
			)
		formatString: #,0
		displayFolder: Funnel
		lineageTag: 2b7b0214-f150-46db-92f8-71cd66bf4cd6

	/// share lost at this step vs the previous one. ALL ( FunnelStep ) first: the visual also filters FunnelStep[Step] (and Order, its sort column), so only replacing the Order filter would leave Step = this step and find no previous row.
	measure 'Funnel Step Drop-off %' =
			VAR curr = [Funnel Step Sessions]
			VAR prevOrder = SELECTEDVALUE ( FunnelStep[Order] ) - 1
			VAR prev =
			    CALCULATE (
			        [Funnel Step Sessions],
			        FILTER ( ALL ( FunnelStep ), FunnelStep[Order] = prevOrder )
			    )
			RETURN
			    IF ( prevOrder >= 1, 1 - DIVIDE ( curr, prev ) )
		formatString: 0.0%
		displayFolder: Funnel
		lineageTag: e181190e-7118-4cef-aec2-ce1197c8b2ef

	measure 'Channel Conversion Rate' =
			DIVIDE (
			    SUM ( mart_channel_performance[converting_sessions] ),
			    SUM ( mart_channel_performance[sessions] )
			)
		formatString: 0.00%
		displayFolder: Channels
		lineageTag: c41dad47-6f86-4b8f-9f2c-b4f70a409654

	measure 'Channel Revenue per Session' = DIVIDE ( SUM ( mart_channel_performance[revenue_usd] ), SUM ( mart_channel_performance[sessions] ) )
		formatString: \$#,0.00
		displayFolder: Channels
		lineageTag: 4c872fee-efdd-4ae7-b43d-24316a943dc7

	/// How much of the channel's traffic has no session-level source.
	measure 'Sessions Without Session Source %' =
			DIVIDE (
			    SUMX (
			        mart_channel_performance,
			        mart_channel_performance[share_sessions_without_session_source]
			            * mart_channel_performance[sessions]
			    ),
			    SUM ( mart_channel_performance[sessions] )
			)
		formatString: 0.0%
		displayFolder: Channels
		lineageTag: e394bffb-50f2-4c74-8292-4d81c5df5003

	/// Pooled across cohorts: sum of actives over sum of cohort sizes, so big cohorts weigh more (never average the per-cohort percentages).
	measure 'Retention %' =
			DIVIDE (
			    SUM ( mart_cohort_retention[active_users] ),
			    SUM ( mart_cohort_retention[cohort_users] )
			)
		formatString: 0.0%
		displayFolder: Retention
		lineageTag: 545686cb-bc84-4017-a4a3-1f9000674944

	measure 'Item Revenue' = SUM ( mart_product_performance[item_revenue_usd] )
		formatString: \$#,0
		displayFolder: Products
		lineageTag: 63733d2a-4c3c-4098-b102-0494a99b41c1

	measure 'Units per Viewing Session' =
			DIVIDE (
			    SUM ( mart_product_performance[units_purchased] ),
			    SUM ( mart_product_performance[sessions_viewed] )
			)
		formatString: 0.0%
		displayFolder: Products
		lineageTag: de66d118-d876-4a58-a1c3-49e38fc58335

	/// Rank for "Top N" filtering on the products page.
	measure 'Item Revenue Rank' = RANKX ( ALL ( mart_product_performance[item_name] ), [Item Revenue], , DESC, DENSE )
		formatString: 0
		displayFolder: Products
		lineageTag: f1779d54-0039-449e-904e-feea3f002dda

	/// Header for the Item detail drill-through page.
	measure 'Selected Item' =
			SELECTEDVALUE (
			    mart_product_performance[item_name],
			    "All items: right-click an item on Products > Drill through"
			)
		displayFolder: Products
		lineageTag: cae1aff5-a105-404e-bdb7-3347b06a4eca

	/// Use with a slicer on criteo_estimates[outcome].
	measure 'Naive Lift %' =
			CALCULATE (
			    MAX ( criteo_estimates[rel_lift] ),
			    criteo_estimates[estimator_order] = 0
			)
		formatString: 0.0%
		displayFolder: Experiment
		lineageTag: 5ea5f932-e91c-4429-b3de-fc925d500a84

	measure 'AIPW Lift %' =
			CALCULATE (
			    MAX ( criteo_estimates[rel_lift] ),
			    criteo_estimates[estimator] = "AIPW (doubly robust)"
			)
		formatString: 0.0%
		displayFolder: Experiment
		lineageTag: 1286b86c-96f1-4da0-a8a8-51dd70d42720

	/// how much of the naive effect survives adjustment
	measure 'AIPW Share of Naive %' = DIVIDE ( [AIPW Lift %], [Naive Lift %] )
		formatString: 0%
		displayFolder: Experiment
		lineageTag: bee34785-d699-446f-9d6e-ce311bca09d2

	/// error-bar bounds for the estimates chart
	measure Effect = SUM ( criteo_estimates[diff] )
		formatString: 0.00000
		displayFolder: Experiment
		lineageTag: 63e90ba1-6cc9-4c9c-bed6-1ad108c3dc54

	measure 'Effect CI Low' = SUM ( criteo_estimates[ci_low] )
		formatString: 0.00000
		displayFolder: Experiment
		lineageTag: 999fb13a-95cd-4e7c-9b29-dfe90af5d583

	measure 'Effect CI High' = SUM ( criteo_estimates[ci_high] )
		formatString: 0.00000
		displayFolder: Experiment
		lineageTag: c992c91d-2006-466a-930f-0607c6cfd572

	measure 'Share of Incremental' = SUM ( criteo_segments[share_of_incremental] )
		formatString: 0%
		displayFolder: Experiment
		lineageTag: d1d58fcd-3533-4272-956f-d2a1a3675878

	/// A/A false-positive rate (lift = 0) of the selected analysis.
	measure 'False Positive Rate' = CALCULATE ( AVERAGE ( sim_calibration[rejection_rate] ), sim_calibration[lift] = 0 )
		formatString: 0.0%
		displayFolder: Experiment
		lineageTag: 90ef041b-d867-41fd-9327-e47cae925352

	/// Users per arm for a two-sided z-test on a conversion rate. Inputs: Baseline Rate, Relative MDE, Power (what-if parameters); alpha fixed at 5%.
	measure 'Users per Arm' =
			VAR p1 = [Baseline Rate Value]
			VAR p2 = p1 * ( 1 + [Relative MDE Value] )
			VAR zA = NORM.S.INV ( 1 - 0.05 / 2 )
			VAR zB = NORM.S.INV ( [Power Value] )
			RETURN
			    ROUNDUP ( ( zA + zB ) ^ 2 * ( p1 * ( 1 - p1 ) + p2 * ( 1 - p2 ) ) / ( p2 - p1 ) ^ 2, 0 )
		formatString: #,0
		displayFolder: Sample size
		lineageTag: 4af42547-c8e6-42d9-9ff6-778e9df9269e

	/// Days at the store's traffic (3,159 new experiment users a day in Dec-Jan).
	measure 'Days Needed' = DIVIDE ( 2 * [Users per Arm], [Daily Users Value] )
		formatString: 0.0
		displayFolder: Sample size
		lineageTag: c4b05332-e49f-4f9d-9625-ddf8a84f1723

	column Dummy
		dataType: string
		isHidden
		lineageTag: e2f2fdaf-ec90-4319-b8b0-ddd6147d95c0
		summarizeBy: none
		sourceColumn: Dummy

	partition _Measures = m
		mode: import
		source = #table(type table [Dummy = text], {})

