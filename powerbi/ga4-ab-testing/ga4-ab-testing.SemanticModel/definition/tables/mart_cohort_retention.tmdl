table mart_cohort_retention
	lineageTag: 9f199f0a-3739-4868-8f4c-d4e680df6d4a

	column cohort_week
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 0862f6b1-8920-4d76-8448-0a9fe02f05a3
		summarizeBy: none
		sourceColumn: cohort_week

		annotation UnderlyingDateTimeDataType = Date

	column week_number
		dataType: int64
		formatString: #,0
		lineageTag: 9a66c0f9-914e-4ab5-a80e-43a8cc840a20
		summarizeBy: none
		sourceColumn: week_number

	column cohort_users
		dataType: int64
		formatString: #,0
		lineageTag: 2784fcf3-3e48-48c9-84f9-f874799d5160
		summarizeBy: sum
		sourceColumn: cohort_users

	column active_users
		dataType: int64
		formatString: #,0
		lineageTag: 53617211-651c-4874-8cd3-fa59c0a82524
		summarizeBy: sum
		sourceColumn: active_users

	column retention
		dataType: double
		formatString: 0.0%
		lineageTag: 7b00a530-093c-48e9-99b1-bb6ec9149544
		summarizeBy: none
		sourceColumn: retention

	partition mart_cohort_retention = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\mart_cohort_retention.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Headers, {"cohort_week", "week_number", "cohort_users", "active_users", "retention"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" or _ = "nan" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"cohort_week", type date}, {"week_number", Int64.Type}, {"cohort_users", Int64.Type}, {"active_users", Int64.Type}, {"retention", type number}}, "en-US")
				in
				    Typed

