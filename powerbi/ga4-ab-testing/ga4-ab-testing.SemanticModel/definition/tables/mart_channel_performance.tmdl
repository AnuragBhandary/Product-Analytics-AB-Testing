		summarizeBy: sum
		sourceColumn: sessions

	column engagement_rate
		dataType: double
		formatString: 0.0%
		lineageTag: 79da82f8-83bd-4326-8b21-13fb4ea09744
		summarizeBy: none
		sourceColumn: engagement_rate

	column converting_sessions
		dataType: int64
		formatString: #,0
