	partition mart_channel_performance = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\mart_channel_performance.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Headers, {"acquisition_channel", "device_category", "users", "sessions", "engagement_rate", "converting_sessions", "session_conversion_rate", "revenue_usd", "revenue_per_session_usd", "share_sessions_without_session_source"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" or _ = "nan" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"acquisition_channel", type text}, {"device_category", type text}, {"users", Int64.Type}, {"sessions", Int64.Type}, {"engagement_rate", type number}, {"converting_sessions", Int64.Type}, {"session_conversion_rate", type number}, {"revenue_usd", Currency.Type}, {"revenue_per_session_usd", Currency.Type}, {"share_sessions_without_session_source", type number}}, "en-US")
				in
				    Typed

