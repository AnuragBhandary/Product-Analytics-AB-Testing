	partition criteo_segments = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\criteo_segments.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Headers, {"outcome", "segment", "users", "mean_score", "diff", "ci_low", "ci_high", "p_value", "incremental_outcomes", "p_bh", "share_of_incremental"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" or _ = "nan" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"outcome", type text}, {"segment", Int64.Type}, {"users", Int64.Type}, {"mean_score", type number}, {"diff", type number}, {"ci_low", type number}, {"ci_high", type number}, {"p_value", type number}, {"incremental_outcomes", type number}, {"p_bh", type number}, {"share_of_incremental", type number}}, "en-US")
				in
				    Typed

